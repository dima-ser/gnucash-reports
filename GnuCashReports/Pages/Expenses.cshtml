@page
@model ExpensesModel
@{
    ViewData["Title"] = "Expenses";
}
@using GnuCashReports.Models

<h1 class="text-center">Expenses</h1>

<table class="table">
    <thead>
        <tr>
            <th scope="col"></th>
            <th scope="col">@(DateTime.Now.Year - 1)</th>
            <th class="text-end" scope="col">@DateTime.Now.Year YTD</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ProfitLossData.Where(i => i.AccountType == AppSettings.ACCOUNT_TYPE_EXPENSE).OrderBy(i => i.AccountName))
        {
            <tr>
                <td><span style="vertical-align:2px">@(Model.ExpenseAccountEmojis != null && Model.ExpenseAccountEmojis.ContainsKey(item.AccountName) ? Model.ExpenseAccountEmojis[item.AccountName]+" " : "")</span>@item.AccountName </td>
                <td>@item.TotalAmountPrevYear.ToString("C0")</td>
                <td class="text-end" @((item.TotalAmountYTD / (decimal)(DateTime.Now.Month / 12.0) > item.TotalAmountPrevYear) ? Html.Raw("class=\"text-danger\"") : "")>@item.TotalAmountYTD.ToString("C0")</td>
            </tr>
        }
        <tr>
            <td><b>TOTAL EXPENSES</b></td>
            <td><b>@Model.ProfitLossData.Where(i => i.AccountType == AppSettings.ACCOUNT_TYPE_EXPENSE).Sum(i => i.TotalAmountPrevYear).ToString("C0")</b></td>
            <td class="text-end"><b>@Model.ProfitLossData.Where(i => i.AccountType == AppSettings.ACCOUNT_TYPE_EXPENSE).Sum(i => i.TotalAmountYTD).ToString("C0")</b></td>
        </tr>
    </tbody>
</table>
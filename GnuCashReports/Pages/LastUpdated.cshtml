@page
@model LastUpdatedModel
@{
    ViewData["Title"] = "Last Updated Date";
}
@using GnuCashReports.Services

<div style="text-align:center; margin-top:10px;font-style:italic">
    Last transaction: @Model.LastUpdated.LastTransactionDate.ToShortDateString()<br/>
    Last price: @Model.LastUpdated.LastPriceDate.ToShortDateString()<br />
</div>
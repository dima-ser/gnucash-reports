@page
@model CashflowModel
@{
    ViewData["Title"] = "Cash Flow";
}
@using GnuCashReports.Models
@using GnuCashReports.Pages;

<h1 class="text-center">Cash Flow</h1>
<div id="global-loader" class="htmx-indicator">
  <img id="spinner" src="/img/loading.gif" class="htmx-indicator" alt="Loading..."/>
</div>
<table class="table">

    <thead>
        <tr>
            <th scope="col"></th>
            <th scope="col">
                 <select asp-for="YearLeft" asp-items="Model.YearListLeft" 
                    hx-get="@Url.Page("CashFlow")" 
                    hx-target="#cfdata"
                    hx-include="[name='YearLeft'], [name='YearRight']"
                    hx-indicator="#global-loader">
                </select>
            </th>
            <th class="text-end" scope="col">
                <select asp-for="YearRight" asp-items="Model.YearListRight" 
                    hx-get="@Url.Page("CashFlow")" 
                    hx-target="#cfdata"
                    hx-include="[name='YearLeft'], [name='YearRight']"
                    hx-indicator="#global-loader">
                </select>
            </th>
        </tr>
    </thead>

    <tbody id="cfdata">
        @await Html.PartialAsync("CashflowPartial")
    </tbody>
</table>
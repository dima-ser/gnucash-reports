@page
@model CashflowModel
@{
    ViewData["Title"] = "Cash Flow";
}
@using GnuCashReports.Models

<h1 class="text-center">Cash Flow</h1>

<table class="table">
    <thead>
        <tr>
            <th scope="col"></th>
            <th scope="col">@(DateTime.Now.Year - 1)</th>
            <th class="text-end" scope="col">@DateTime.Now.Year YTD</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <th colspan="3" scope="col">INFLOWS</th>
            @* <th scope="col">@(DateTime.Now.Year - 1)</th>
            <th class="text-end" scope="col">@DateTime.Now.Year YTD</th> *@
        </tr>
        @foreach (KeyValuePair<string, decimal> item in Model.Inflows1)
        {
            <tr>
                <td>&nbsp;@item.Key</td>
                <td></td> 
                <td class="text-end">@((item.Value).ToString("C0"))</td>
            </tr>
        }
        <tr>
            <td><b>TOTAL INFLOWS</b></td>
            <td></td>
            <td class="text-end"><b>@((Model.Inflows1.Sum(i=>i.Value)).ToString("C0"))</b></td>
        </tr>
        <tr>
            <th colspan="3" scope="col">OUTFLOWS</th>
        </tr>
        @foreach (KeyValuePair<string, decimal> item in Model.Outflows1)
        {
            <tr>
                <td>&nbsp;@item.Key</td>
                <td></td>
                <td class="text-end">@((item.Value).ToString("C0"))</td>
            </tr>
        }
        <tr>
            <td><b>TOTAL OUTFLOWS</b></td>
            <td></td>
            <td class="text-end"><b>@((Model.Outflows1.Sum(i=>i.Value)).ToString("C0"))</b></td>
        </tr>
        <tr style="font-size:large">
            <td><b>NET CHANGE IN CASH</b></td>
            <td></td>
            <td class="text-end"><b>@((Model.Inflows1.Sum(i=>i.Value) - Model.Outflows1.Sum(i=>i.Value)).ToString("C0"))</b></td>
        </tr>
    </tbody>
</table>
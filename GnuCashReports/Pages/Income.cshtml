@page
@model IncomeModel
@{
    ViewData["Title"] = "Income";
}
@using GnuCashReports.Models

<h1>Income</h1>

<table class="table">
    <thead>
        <tr>
            <th scope="col"></th>
            <th scope="col">@(DateTime.Now.Year - 1)</th>
            <th scope="col">@DateTime.Now.Year YTD</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ProfitLossData.Where(i => i.AccountType == AppSettings.ACCOUNT_TYPE_INCOME).OrderBy(i => i.AccountName))
        {
            <tr>
                <td>@item.AccountName</td>
                <td>@((-item.TotalAmountPrevYear).ToString("C0"))</td>
                <td>@((-item.TotalAmountYTD).ToString("C0"))</td>
            </tr>
        }
        <tr>
            <td><b>TOTAL INCOME</b></td>
            <td><b>@((-Model.ProfitLossData.Where(i => i.AccountType == AppSettings.ACCOUNT_TYPE_INCOME).Sum(i => i.TotalAmountPrevYear)).ToString("C0"))</b></td>
            <td><b>@((-Model.ProfitLossData.Where(i => i.AccountType == AppSettings.ACCOUNT_TYPE_INCOME).Sum(i => i.TotalAmountYTD)).ToString("C0"))</b></td>
        </tr>
    </tbody>
</table>
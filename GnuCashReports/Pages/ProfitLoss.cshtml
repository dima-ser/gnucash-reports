@page
@model ProfitLossModel
@{
    ViewData["Title"] = "Profit & Loss";
}
@using GnuCashReports.Models

<h2 class="text-center">Profit & Loss</h2>

<table class="table">
    <thead>
        <tr>
            <th scope="col"></th>
            <th scope="col">@(DateTime.Now.Year - 1)</th>
            <th class="text-end" scope="col">@DateTime.Now.Year YTD</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td colspan="3"><b>INCOME</b></td>
        </tr>
        @foreach (var item in Model.ProfitLossData.Where(i => i.AccountType == AppSettings.ACCOUNT_TYPE_INCOME).OrderBy(i => i.AccountName))
        {
            <tr>
                <td>@item.AccountName</td>
                <td>@((-item.TotalAmountPrevYear).ToString("C0"))</td>
                <td class="text-end">@((-item.TotalAmountYTD).ToString("C0"))</td>
            </tr>
        }
        <tr>
            <td><b>TOTAL INCOME</b></td>
            <td><b>@((-Model.ProfitLossData.Where(i => i.AccountType == AppSettings.ACCOUNT_TYPE_INCOME).Sum(i => i.TotalAmountPrevYear)).ToString("C0"))</b></td>
            <td class="text-end"><b>@((-Model.ProfitLossData.Where(i => i.AccountType == AppSettings.ACCOUNT_TYPE_INCOME).Sum(i => i.TotalAmountYTD)).ToString("C0"))</b></td>
        </tr>
        <tr>
            <td colspan="4"><b>EXPENSES</b></td>
        </tr>
        @foreach (var item in Model.ProfitLossData.Where(i => i.AccountType == AppSettings.ACCOUNT_TYPE_EXPENSE).OrderBy(i => i.AccountName))
        {
            <tr>
                <td>@item.AccountName</td>
                <td>@item.TotalAmountPrevYear.ToString("C0")</td>
                <td class="text-end">@item.TotalAmountYTD.ToString("C0")</td>
            </tr>
        }
        <tr>
            <td><b>TOTAL EXPENSES</b></td>
            <td><b>@Model.ProfitLossData.Where(i => i.AccountType == AppSettings.ACCOUNT_TYPE_EXPENSE).Sum(i => i.TotalAmountPrevYear).ToString("C0")</b></td>
            <td class="text-end"><b>@Model.ProfitLossData.Where(i => i.AccountType == AppSettings.ACCOUNT_TYPE_EXPENSE).Sum(i => i.TotalAmountYTD).ToString("C0")</b></td>
        </tr>
    </tbody>
</table>
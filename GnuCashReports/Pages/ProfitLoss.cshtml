@page
@model ProfitLossModel
@{
    ViewData["Title"] = "Profit & Loss";
}
@using GnuCashReports.Models

<h1 class="text-center">Profit & Loss</h1>

<table class="table">
    <form method="get" class="d-inline">
    <thead>
            <tr>
            <th scope="col"></th>
            <th scope="col">
                <select asp-for="YearLeft" asp-items="Model.YearListLeft" onchange="this.form.submit()"></select>
            </th>
            <th class="text-end" scope="col">
                <select asp-for="YearRight" asp-items="Model.YearListRight" onchange="this.form.submit()"></select>
            </th>
        </tr>
    </thead>
    </form>
    <tbody>
        <tr>
            <td colspan="3"><b>INCOME</b></td>
        </tr>
        @foreach (var item in Model.Income)
        {
            <tr>
                <td>@item.Name</td>
                <td>@((-item.AmountLeft).ToString("C0"))</td>
                <td class="text-end">@((-item.AmountRight).ToString("C0"))</td>
            </tr>
        }
        <tr>
            <td><b>TOTAL INCOME</b></td>
            <td><b>@((-Model.Income.Sum(i => i.AmountLeft)).ToString("C0"))</b></td>
            <td class="text-end"><b>@((-Model.Income.Sum(i => i.AmountRight)).ToString("C0"))</b></td>
        </tr>
        <tr>
            <td colspan="4"><b>EXPENSES</b></td>
        </tr>
        @foreach (var item in Model.Expenses)
        {
            <tr>
                <td> <span style="vertical-align:2px">@(Model.ExpenseAccountEmojis != null && Model.ExpenseAccountEmojis.ContainsKey(item.Name) ? Model.ExpenseAccountEmojis[item.Name]+" " : "")</span>@item.Name</td>
                <td>@item.AmountLeft.ToString("C0")</td>
                <td class="text-end @((item.AmountRight / (decimal)(DateTime.Now.Month / 12.0) > item.AmountLeft && Model.YearRight == DateTime.Now.Year && Model.YearLeft < Model.YearRight) ? "text-danger" : "" )">@item.AmountRight.ToString("C0")</td>
            </tr>
        }
        <tr>
            <td><b>TOTAL EXPENSES</b></td>
            <td><b>@Model.Expenses.Sum(i => i.AmountLeft).ToString("C0")</b></td>
            <td class="text-end"><b>@Model.Expenses.Sum(i => i.AmountRight).ToString("C0")</b></td>
        </tr>
    </tbody>
</table>
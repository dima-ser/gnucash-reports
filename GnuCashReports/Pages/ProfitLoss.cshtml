@page
@model ProfitLossModel
@{
    ViewData["Title"] = "Profit & Loss";
}
@using GnuCashReports.Models

<h1 class="text-center">Profit & Loss</h1>

<table class="table">
    <thead>
            <tr>
            <th scope="col"></th>
            <th scope="col">
                <select asp-for="YearLeft" asp-items="Model.YearListLeft" 
                    hx-get="@Url.Page("ProfitLoss")" 
                    hx-target="#pldata"
                    hx-include="[name='YearLeft'], [name='YearRight']">
                </select>
            </th>
            <th class="text-end" scope="col">
                <select asp-for="YearRight" asp-items="Model.YearListRight" 
                    hx-get="@Url.Page("ProfitLoss")" 
                    hx-target="#pldata"
                    hx-include="[name='YearLeft'], [name='YearRight']">
                </select>
            </th>
        </tr>
    </thead>
    <tbody id="pldata">
        @await Html.PartialAsync("ProfitLossPartial")
    </tbody>
</table>
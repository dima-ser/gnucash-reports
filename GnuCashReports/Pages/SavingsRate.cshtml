@page
@model SavingsRateModel
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Savings Rate";
}

<h1 style="text-align:center">Savings Rate</h1>


<div class="container mt-4">
  <div class="row">
    <div class="col-6">
        <p style="text-align:center">
            <select asp-for="YearLeft" asp-items="Model.YearListLeft" 
                hx-get="@Url.Page("SavingsRate")" 
                hx-swap="none" 
                hx-include="[name='YearLeft'], [name='YearRight']" >
            </select>
        </p>
      <canvas id="chart"></canvas>
    </div>
    <div class="col-6">
        <p style="text-align:center">
            <select asp-for="YearRight" asp-items="Model.YearListRight" 
                hx-get="@Url.Page("SavingsRate")" 
                hx-swap="none" 
                hx-include="[name='YearLeft'], [name='YearRight']" >
            </select>
        </p>
      <canvas id="chart2"></canvas>
    </div>
  </div>
</div>



@section Scripts {
<script>
    const root = document.documentElement;
    const successColor = getComputedStyle(root).getPropertyValue('--my-success-color').trim();
    const dangerColor = getComputedStyle(root).getPropertyValue('--bs-danger').trim();

    const labels = [ "Spent", "Saved"];
    const data = @Html.Raw(JsonConvert.SerializeObject(new[] { Model.percentSpentLeftYear, Model.percentSavedLeftYear }));
    const data2 = @Html.Raw(JsonConvert.SerializeObject(new[] { Model.percentSpentRightYear, Model.percentSavedRightYear }));
            const colors = [dangerColor, successColor];

    //const ctx = document.getElementById('plChart').getContext('2d');
    const chart = new Chart('chart', {
        type: 'pie',
        data: {
            labels: labels,
            datasets: [{
                label: 'Percent',
                data: data,
                backgroundColor: colors,
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
               x: {
                  display: false,
               },
               y: {
                  display: false,
               }
            },
            plugins: {
                legend: {
                    display: false,
                }
            }
        }
    });
     const chart2 = new Chart('chart2', {
        type: 'pie',
        data: {
            labels: labels,
            datasets: [{
                label: 'Percent',
                data: data2,
                backgroundColor: colors,
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
               x: {
                  display: false,
               },
               y: {
                  display: false,
               }
            },
            plugins: {
                legend: {
                    display: false,
                }
            }
        }
    });

    // Bind the custom HTMX event listener
    document.body.addEventListener('refreshChart', (evt) => {
        // HTMX places the server payload inside event.detail
        const { data, data2 } = evt.detail;

        if (chart) {
            // Inject data and call the native update method
            chart.data.datasets[0].data = data;
            chart.update(); 
        }
        if (chart2) {
            // Inject data and call the native update method
            chart2.data.datasets[0].data = data2;
            chart2.update(); 
        }
    });
</script>
}
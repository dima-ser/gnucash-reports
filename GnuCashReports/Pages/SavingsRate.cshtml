@page
@model SavingsRateModel
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Savings Rate";
}

<h1 style="text-align:center">Savings Rate</h1>

<form method="get" class="d-inline">
<div class="container mt-4">
  <div class="row">
    <div class="col-6">
        <p style="text-align:center"><select asp-for="YearLeft" asp-items="Model.YearListLeft" onchange="this.form.submit()"></select></p>
      <canvas id="chart"></canvas>
    </div>
    <div class="col-6">
        <p style="text-align:center"><select asp-for="YearRight" asp-items="Model.YearListRight" onchange="this.form.submit()"></select></p>
      <canvas id="chart2"></canvas>
    </div>
  </div>
</div>
</form>
    


@section Scripts {
<script>
    const root = document.documentElement;
    const successColor = getComputedStyle(root).getPropertyValue('--my-success-color').trim();
    const dangerColor = getComputedStyle(root).getPropertyValue('--bs-danger').trim();

    const labels = [ "Spent", "Saved"];
    const data = [@Model.percentSpentLeftYear, @Model.percentSavedLeftYear];
    const data2 = [@Model.percentSpentRightYear, @Model.percentSavedRightYear];
            const colors = [dangerColor, successColor];

    //const ctx = document.getElementById('plChart').getContext('2d');
    const chart = new Chart('chart', {
        type: 'pie',
        data: {
            labels: labels,
            datasets: [{
                label: 'Percent',
                data: data,
                backgroundColor: colors,
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
               x: {
                  display: false,
               },
               y: {
                  display: false,
               }
            },
            plugins: {
                legend: {
                    display: false,
                }
            }
        }
    });
     const chart2 = new Chart('chart2', {
        type: 'pie',
        data: {
            labels: labels,
            datasets: [{
                label: 'Percent',
                data: data2,
                backgroundColor: colors,
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
               x: {
                  display: false,
               },
               y: {
                  display: false,
               }
            },
            plugins: {
                legend: {
                    display: false,
                }
            }
        }
    });
</script>
}
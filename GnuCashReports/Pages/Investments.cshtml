@page
@model InvestmentsModel
@{
    ViewData["Title"] = "Investments";
}
@using GnuCashReports.Services
<h1 class="text-center">Investments</h1>

<div class="text-center">
    <h2 style="font-size: 9vw;">@Model.TotalAmount.ToString("C0")</h2>
    <span style="font-size: 4vw;">
        <span @(Model.NetChange < 0 ? Html.Raw("class='text-danger'") : Html.Raw("class='text-success'"))>@Model.NetChange.ToString("+#,##0;-#,##0;0") 
            (@(Model.NetPercentageChange == Decimal.MaxValue ? Html.Raw("&infin;%") : Model.NetPercentageChange.ToString("P2")))
        </span> since @Model.NetChangeIntervalUserFriendly
        </span> <br/>
    <span style="font-size: 4vw;">
        <span @(Model.NetChange2 < 0 ? Html.Raw("class='text-danger'") : Html.Raw("class='text-success'"))>
            @Model.NetChange2.ToString("+#,##0;-#,##0;0")
            (@(Model.NetPercentageChange2 == Decimal.MaxValue ? Html.Raw("&infin;%") : Model.NetPercentageChange2.ToString("P2")))
        </span> since @Model.NetChangeIntervalUserFriendly2
    </span>
</div>
@* <div class="container">
    <div style="display: flex; justify-content: center; align-items: center; height: 50vh;">
        <canvas id="chart"></canvas>
    </div>
</div> *@
<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>US</th>
            <th>Intnl</th>
            <th class="text-end">Bonds</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Target<br />Allocation</td>
            <td>@Model.TargetAssetAllocation.US%</td>
            <td>@Model.TargetAssetAllocation.INTNL%</td>
            <td class="text-end">@Model.TargetAssetAllocation.BND%</td>
        </tr>
        <tr>
            <td>Actual<br />Allocation</td>
            <td>@Model.ActualAssetAllocation!.US.ToString("F1")%</td>
            <td>@Model.ActualAssetAllocation!.INTNL.ToString("F1")%</td>
            <td class="text-end">@Model.ActualAssetAllocation!.BND.ToString("F1")%</td>
        </tr>
        <tr>
            <td>Target<br />Amounts</td>
            <td>@(Model.TargetAmountUS.ToString("C0")) </td>
            <td>@(Model.TargetAmountIntnl.ToString("C0")) </td>
            <td class="text-end">@(Model.TargetAmountBonds.ToString("C0"))</td>
        </tr>
        <tr>
            <td>Actual<br />Amounts</td>
            <td>@Model.ActualAmountUS.ToString("C0")</td>
            <td>@Model.ActualAmountIntnl.ToString("C0")</td>
            <td class="text-end">@Model.ActualAmountBonds.ToString("C0")</td>
        </tr>
        <tr>
            <td>Off Target by<br />(USD)</td>
            <td>@((Model.ActualAmountUS - Model.TargetAmountUS).ToString("C0"))</td>
            <td>@((Model.ActualAmountIntnl - Model.TargetAmountIntnl).ToString("C0"))</td>
            <td class="text-end">@((Model.ActualAmountBonds - Model.TargetAmountBonds).ToString("C0"))</td>

        </tr>
        <tr>
            <td>Off Target by<br />(relative %)</td>
            <td>@(((Model.ActualAmountUS - Model.TargetAmountUS) / Model.TargetAmountUS * 100).ToString("F1"))%</td>
            <td>@(((Model.ActualAmountIntnl - Model.TargetAmountIntnl) / Model.TargetAmountIntnl * 100).ToString("F1"))%</td>
            <td class="text-end">@(((Model.ActualAmountBonds - Model.TargetAmountBonds) / Model.TargetAmountBonds * 100).ToString("F1"))%</td>

        </tr>
        <tr>
            <td><b>Rebalance?</b></td>
            <td><b @(Model.RebalanceUS? Html.Raw("class=\"text-danger\"") : Html.Raw("class=\"text-success\""))>@(Model.RebalanceUS ? "YES" : "NO")</b></td>
            <td><b @(Model.RebalanceIntnl? Html.Raw("class=\"text-danger\"") : Html.Raw("class=\"text-success\""))>@(Model.RebalanceIntnl ? "YES" : "NO")</b></td>
            <td class="text-end"><b @(Model.RebalanceBonds? Html.Raw("class=\"text-danger\"") : Html.Raw("class=\"text-success\""))>@(Model.RebalanceBonds ? "YES" : "NO")</b></td>

        </tr>
    </tbody>
</table>

@page
@model AvailableToSpendModel
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Available to Spend";
}

<h1 class="text-center">Available to Spend</h1>


<div @(Model.availableToSpendThisRollingYear <= 0 ? Html.Raw("class=\"text-center text-danger\"") : Html.Raw("class=\"text-center text-success\""))>
  <h2 style="font-size: 20vw;">@Model.availableToSpendThisRollingYear.ToString("C0")</h2>
</div>
<div style="text-align:center">
    <i>*to maintain <b>@Model.budgetSavingsRatePercentage%</b> savings rate for rolling year</i>
</div>
@model BalanceSheetModel
@{ ArgumentNullException.ThrowIfNull(Model); }
@using GnuCashReports.Models

<tr>
    <td colspan="2"><b>ASSETS</b></td>
</tr>
@foreach (var item in Model.BalanceSheetData.Where(i => i.AccountType == AccountType.ASSET))
{
    <tr>
        <td>&nbsp;@item.AccountName</td>
        <td class="text-end">@((item.Amount).ToString("C0"))</td>
    </tr>
}
<tr>
    <td><b>TOTAL ASSETS</b></td>
    <td class="text-end"><b>@((Model.BalanceSheetData.Where(i => i.AccountType == AccountType.ASSET).Sum(i => i.Amount)).ToString("C0"))</b></td>
</tr>
<tr>
    <td colspan="2"></td>
</tr>
<tr>
    <td colspan="2"><b>LIABILITIES</b></td>
</tr>
@foreach (var item in Model.BalanceSheetData.Where(i => i.AccountType == AccountType.LIABILITY).OrderBy(i => i.AccountName))
{
    <tr>
        <td>&nbsp;@item.AccountName</td>
        <td class="text-end">@item.Amount.ToString("C0")</td>
    </tr>
}
<tr>
    <td><b>TOTAL LIABILITIES</b></td>
    <td class="text-end"><b>@Model.BalanceSheetData.Where(i => i.AccountType == AccountType.LIABILITY).Sum(i => i.Amount).ToString("C0")</b></td>
</tr>
<tr>
    <td colspan="2"></td>
</tr>
<tr style="font-size:large">
    <td><b>NET WORTH</b></td>
    <td class="text-end"><b>@((Model.BalanceSheetData.Where(i => i.AccountType == AccountType.ASSET).Sum(i => i.Amount) +
                                Model.BalanceSheetData.Where(i => i.AccountType == AccountType.LIABILITY).Sum(i => i.Amount)).ToString("C0"))
        </b>
    </td>
</tr>
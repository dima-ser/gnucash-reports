@page
@model FIReportModel
@{
    ViewData["Title"] = "Financial Independence Report";
}
@using GnuCashReports.Models

<h1>FI Report</h1>

<table class="table">
@*     <thead>
        <tr>
            <th scope="col"></th>
            <th scope="col">@(DateTime.Now.Year - 1)</th>
            <th scope="col">@DateTime.Now.Year YTD</th>
        </tr>
    </thead> *@
    <tbody>
        <tr>
            <td>Total Liquid Assets</td>
            <td style="font-size:large">
                <b>
                    @((Model.TotalLiquidAssets).ToString("C0"))
                </b>
            </td>
        </tr>
        <tr >
            <td>Average Annual Expenses</td>
            <td style="font-size:large">
                <b>
                    @(Model.AverageAnnualExpenses.ToString("C0"))
                </b>
            </td>
        </tr>
        <tr >
            <td>Total Needed for FI</td>
            <td style="font-size:large">
                <b>
                    @(Model.TotalNeededForFI.ToString("C0"))
                </b>
            </td>
        </tr>
        <tr>
            <td><b>Progress Towards FI</b></td>
            <td style="font-size:large">
                <b>
                    @((Model.TotalLiquidAssets / Model.TotalNeededForFI).ToString("P1"))
                </b>
            </td>
        </tr>
    </tbody>
</table>
<div>
    <i>*Assuming a @(Model.SafeWithdrawalRate.ToString("P0")) withdrawal rate and @(Model.AvergeExpensesYearsLookback) years lookback period to determine average expenses</i>
</div>
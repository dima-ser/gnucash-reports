@page
@model BalanceSheetModel
@{
    ViewData["Title"] = "Balance Sheet";
}
@using GnuCashReports.Models

<h1 class="text-center">Balance Sheet</h1>

<table class="table">
    <thead>
        <tr>
            <th scope="col"></th>
            <th class="text-end" scope="col">
                <select asp-for="Date" asp-items="Model.DateList" 
                    hx-get="@Url.Page("BalanceSheet")" 
                    hx-target="#bsdata"></select>
            </th>
        </tr>
    </thead> 
    <tbody id="bsdata">
        @await Html.PartialAsync("BalanceSheetPartial")
    </tbody>
</table>
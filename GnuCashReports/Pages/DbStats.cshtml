@page
@model DbStatsModel
@{
    ViewData["Title"] = "Database Statistics";
}
@using GnuCashReports.Services

<h1 class="text-center">Database Stats</h1>
<div class="container pb-5 pt-1 px-0">
  <div class="row row-cols-2 row-cols-md-4 g-4">

    <div class="col">
      <div class="card h-100 text-center shadow">
        <div class="card-body">
          <h2 class="card-title mb-3">@Model.DbStats.LastUpdatedDate.ToShortDateString()</h2>
          <p class="card-text text-muted">Last Updated</p>
        </div>
      </div>
    </div>
    
    <div class="col">
      <div class="card h-100 text-center shadow">
        <div class="card-body">
          <h2 class="card-title mb-3">@Model.DbStats.LastPriceDate.ToShortDateString()</h2>
          <p class="card-text text-muted">Last Price</p>
        </div>
      </div>
    </div>

    <div class="col">
      <div class="card h-100 text-center shadow">
        <div class="card-body">
          <h2 class="card-title mb-3">@Model.DbStats.CompleteYearsSinceOldestTransaction</h2>
          <p class="card-text text-muted">Years Worth of Data</p>
        </div>
      </div>
    </div>

    <div class="col">
      <div class="card h-100 text-center shadow">
        <div class="card-body">
          <h2 class="card-title mb-3">@Model.DbStats.TransactionCount</h2>
          <p class="card-text text-muted">Transactions</p>
        </div>
      </div>
    </div>

</div>
</div>